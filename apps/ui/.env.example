# Next.js dev/start port. NOTE: `next dev` boots its HTTP server before .env
# is loaded, so PORT must be provided by the process environment — the npm
# scripts in apps/ui/package.json use `node --env-file-if-exists=.env` for this.
PORT=3001

NEXT_PUBLIC_API_URL=http://localhost:3000

# Public site origin — set only once the production domain is approved.
NEXT_PUBLIC_SITE_URL=
