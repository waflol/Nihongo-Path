# Next.js dev/start port. `next dev`/`next start` read PORT from the
# process environment, NOT from .env files (docs Next 16, CLI reference:
# "PORT cannot be set in .env as booting up the HTTP server happens before
# any other code is initialized"). The npm scripts in apps/ui/package.json
# therefore load this .env into the process first, via `dotenv run`:
#
#   dotenv run -- next dev   (see the "dev"/"build"/"start" scripts)
#
# If no .env file exists the scripts still run (dotenv silently skips its
# default path) and Next falls back to port 3000 — which is why we set a
# distinct port here to avoid colliding with the API (apps/api, :3000).
PORT=3001

NEXT_PUBLIC_API_URL=http://localhost:3000

# Public site origin — set only once the production domain is approved.
NEXT_PUBLIC_SITE_URL=
