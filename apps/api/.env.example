NODE_ENV=development
PORT=3000
NODE_OPTIONS=--max-old-space-size=700
WEB_ORIGIN=http://localhost:3001
# MongoDB (cloud) — leave empty to run the API without a database
# (readiness then reports "not-configured").
MONGODB_URL=
# Set to true to fail startup when MONGODB_URL is empty.
MONGODB_URL_REQUIRED=false

# Redis (cloud)
REDIS_URL=

# Where background PDF import jobs keep their files (default: <os tmpdir>/nihongo-import-jobs).
# IMPORT_JOB_DIR=

# AI (optional). Services are added on the admin page (/admin/ai); their API keys
# are encrypted with AI_KEY_SECRET (default: JWT_ACCESS_SECRET). Changing the secret
# in use makes every stored key undecryptable.
AI_KEY_SECRET=
# Read-only fallback Gemini service, tried last.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=10
# AI batches a whole-deck re-check keeps in flight: 1-4.
# RECHECK_CONCURRENCY=2

# Auth (Phase 1)
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-64>
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Admin bootstrap (P2-USER-02) — opt-in. When BOTH are set, startup ensures
# this account exists as an ADMIN with a working email login (idempotent;
# an existing account is promoted, its password untouched). Leave empty to
# keep the manual `node scripts/bootstrap-admin.mjs` flow.
#
# Example:
#   ADMIN_EMAIL=admin@test.vn
#   ADMIN_PASS=<min 8 ký tự>
ADMIN_EMAIL=admin@test.vn
ADMIN_PASS=

# Request logs & IP blocking (see docs/development.md §9)
# Real client IP behind the UI server / reverse proxy: true | hop count | loopback.
# Leave empty if clients can reach the API directly (X-Forwarded-For is spoofable).
TRUST_PROXY=
# Comma-separated IPs that are never blocked.
IP_ALLOWLIST=
RATE_BLOCK_MAX=300
RATE_BLOCK_WINDOW_SEC=10
RATE_BLOCK_MINUTES=15
# true = also persist 401/403/404/429 exceptions to the app log.
LOG_4XX_ALL=false

# Google AI Pro through the Antigravity CLI (admin page -> AI services -> add "Google AI Pro (Antigravity CLI)").
# Each service gets its own HOME for agy under ANTIGRAVITY_CLI_DATA_DIR/<service id>/ (mode 0700).
# Install agy with apps/api/scripts/setup-antigravity-cli.sh; set the full path if it is not in the API's PATH.
# ANTIGRAVITY_CLI_BIN=agy
# Run agy as its own unprivileged OS user (the API must then run as root and drop privileges with setpriv).
# Create it with: sudo ANTIGRAVITY_CLI_USER=agy-runner apps/api/scripts/setup-antigravity-cli.sh --create-user
# ANTIGRAVITY_CLI_USER=agy-runner
# ANTIGRAVITY_CLI_DATA_DIR=./data/antigravity-cli
# Calls running at once (each is a child process; the server is small): 1-4.
# ANTIGRAVITY_CLI_CONCURRENCY=1
# ANTIGRAVITY_CLI_TIMEOUT_MS=120000
